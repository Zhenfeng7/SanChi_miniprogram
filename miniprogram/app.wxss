page { background: #f7f5f1; color: #24211e; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; }
view, text, image, button, input { box-sizing: border-box; }
button { border-radius: 0; } button::after { border: 0; }
.page { padding: 32rpx 32rpx 80rpx; }
.eyebrow { color: #9b8268; font-size: 21rpx; letter-spacing: 5rpx; }
.h1 { font-size: 52rpx; font-weight: 600; letter-spacing: 3rpx; margin: 16rpx 0 34rpx; }
.h2 { font-size: 35rpx; font-weight: 600; margin: 42rpx 0 22rpx; }
.muted { color: #8d8881; font-size: 25rpx; line-height: 1.6; }
.card { background: #fff; border-radius: 12rpx; overflow: hidden; margin-bottom: 24rpx; }
.card-body { padding: 28rpx; }
.btn { background: #705a43; color: #fff; font-size: 28rpx; height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 6rpx; }
.btn[disabled] { background: #c9c3bb; color: #fff; } .btn-light { background: #eeeae4; color: #5b5045; }
.empty { padding: 80rpx 28rpx; text-align: center; color: #938c84; line-height: 1.7; }
.pill { display: inline-block; padding: 9rpx 18rpx; border-radius: 30rpx; background: #ede8df; color: #705a43; font-size: 22rpx; }
