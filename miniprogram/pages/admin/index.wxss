.admin-page { padding-bottom: 120rpx; }.summary { display:flex; justify-content:space-between; align-items:center; padding:32rpx; }.summary-title { font-size:32rpx; font-weight:600; margin:10rpx 0; }.summary-count { font-size:42rpx; color:#705a43; text-align:right; }.summary-count text { display:block; font-size:20rpx; }.chevron { color:#a79a8d; font-size:46rpx; }.section-row { display:flex; justify-content:space-between; align-items:center; }.mini-btn { margin:0; background:#705a43; color:#fff; font-size:23rpx; line-height:60rpx; height:60rpx; padding:0 22rpx; border-radius:5rpx; }.exhibition { display:flex; align-items:center; min-height:145rpx; }.exhibition image,.placeholder { width:145rpx; height:145rpx; flex:none; }.placeholder { background:#b9afa1; color:#fff; display:flex; align-items:center; justify-content:center; }.exhibition-text { padding:20rpx; flex:1; min-width:0; }.exhibition-title { font-size:29rpx; font-weight:600; margin-bottom:8rpx; }.exhibition .pill { margin-top:10rpx; }.exhibition .chevron { padding-right:20rpx; }
