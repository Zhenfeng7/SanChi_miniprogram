.form-page { padding-bottom:130rpx; }.panel { padding:30rpx; }.label { font-size:27rpx; font-weight:600; margin:8rpx 0 14rpx; }.panel input,.panel textarea,.picker { width:100%; background:#f7f5f1; border-radius:5rpx; padding:18rpx; font-size:28rpx; min-height:74rpx; margin-bottom:25rpx; }.panel textarea { min-height:160rpx; line-height:1.5; }.picker { display:flex; align-items:center; }.cover { width:100%; height:350rpx; border-radius:6rpx; }.actions { display:flex; gap:18rpx; }.small-button { background:#eee8df; color:#705a43; font-size:25rpx; height:70rpx; margin:10rpx 0 20rpx; border-radius:5rpx; padding:0 22rpx; }.subtle { background:#f7f5f1; color:#8d8881; }.images { display:flex; gap:12rpx; flex-wrap:wrap; }.image-wrap { position:relative; }.image-wrap image { width:160rpx; height:160rpx; border-radius:5rpx; }.image-wrap text { position:absolute; right:0; top:0; width:42rpx; height:42rpx; line-height:40rpx; text-align:center; color:#fff; background:#705a43; border-radius:50%; }.hint { margin-bottom:18rpx; }.schedule-note { margin-top:4rpx; }.publish { padding:28rpx; display:flex; align-items:center; justify-content:space-between; gap:24rpx; }.publish > view { flex:1; min-width:0; }.save { margin-top:35rpx; }.delete { margin-top:18rpx; background:transparent; color:#9a4e42; font-size:26rpx; }
