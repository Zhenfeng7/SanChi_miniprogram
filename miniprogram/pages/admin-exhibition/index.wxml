<view class="page form-page">
  <view class="eyebrow">EXHIBITION</view><view class="h1">{{id ? '编辑展览' : '新建展览'}}</view>
  <view class="card panel"><view class="label">展览名称 *</view><input value="{{form.title}}" placeholder="例如：春日艺术展" data-field="title" bindinput="text" maxlength="100" /><view class="label">展览介绍</view><textarea value="{{form.description}}" placeholder="向访客介绍展览内容" data-field="description" bindinput="text" maxlength="5000" auto-height /><view class="label">开始日期 *</view><picker mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="date"><view class="picker">{{form.startDate}}　›</view></picker><view class="label">结束日期 *</view><picker mode="date" value="{{form.endDate}}" data-field="endDate" bindchange="date"><view class="picker">{{form.endDate}}　›</view></picker></view>
  <view class="h2">展览图片</view><view class="card panel"><view class="label">封面图片</view><image wx:if="{{coverPreview}}" class="cover" src="{{coverPreview}}" mode="aspectFill" /><view class="actions"><button class="small-button" bindtap="cover">{{uploading ? '上传中…' : '选择封面'}}</button><button wx:if="{{form.coverImage}}" class="small-button subtle" bindtap="removeCover">移除</button></view><view class="label">详情图片</view><view class="images"><view wx:for="{{galleryPreviews}}" wx:key="*this" class="image-wrap"><image wx:if="{{item}}" src="{{item}}" mode="aspectFill" /><text data-index="{{index}}" bindtap="removeImage">×</text></view></view><button class="small-button" bindtap="gallery">＋ 添加详情图片</button></view>
  <view class="h2">每日预约时段</view><view class="muted hint">每档 1 小时，结束时间表示最后一档的结束时间。默认 10:00—17:00，每档 12 人。</view><view class="card panel"><view class="label">开始时间</view><picker range="{{startOptions}}" value="{{schedule.start}}" data-field="start" bindchange="scheduleHour"><view class="picker">{{startOptions[schedule.start]}}　›</view></picker><view class="label">结束时间</view><picker range="{{endOptions}}" value="{{schedule.end - 1}}" data-field="end" bindchange="scheduleHour"><view class="picker">{{endOptions[schedule.end - 1]}}　›</view></picker><view class="label">每个时段可预约总人数</view><input type="number" value="{{schedule.capacity}}" bindinput="scheduleCapacity" placeholder="例如 12" /><view wx:if="{{schedule.irregular && !scheduleChanged}}" class="muted schedule-note">现有时段不连续或人数不同；修改以上设置后会按连续时段重新生成。</view><view wx:else class="muted schedule-note">共 {{form.dailySlots.length}} 个 1 小时时段</view></view>
  <view class="card publish"><view><view class="label">发布展览</view><view class="muted">开启：访客可在首页、预约页看到展览，并在开放日期预约。关闭：访客看不到，可先保存为草稿。</view></view><switch color="#705a43" checked="{{form.published}}" bindchange="published" /></view>
  <button class="btn save" loading="{{saving}}" bindtap="save">保存展览</button><button wx:if="{{id}}" class="delete" bindtap="remove">下架并归档展览</button>
</view>
