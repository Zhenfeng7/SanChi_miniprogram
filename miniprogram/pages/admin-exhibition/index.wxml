<view class="page form-page">
  <view class="eyebrow">EXHIBITION</view><view class="h1">{{id ? '编辑展览' : '新建展览'}}</view>
  <view class="card panel"><view class="label">展览名称 *</view><input value="{{form.title}}" placeholder="例如：春日艺术展" data-field="title" bindinput="text" maxlength="100" /><view class="label">展览介绍</view><textarea value="{{form.description}}" placeholder="向访客介绍展览内容" data-field="description" bindinput="text" maxlength="5000" auto-height /><view class="label">开始日期 *</view><picker mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="date"><view class="picker">{{form.startDate}}　›</view></picker><view class="label">结束日期 *</view><picker mode="date" value="{{form.endDate}}" data-field="endDate" bindchange="date"><view class="picker">{{form.endDate}}　›</view></picker></view>
  <view class="h2">展览图片</view><view class="card panel"><view class="label">封面图片</view><image wx:if="{{form.coverImage}}" class="cover" src="{{form.coverImage}}" mode="aspectFill" /><view class="actions"><button class="small-button" bindtap="cover">{{uploading ? '上传中…' : '选择封面'}}</button><button wx:if="{{form.coverImage}}" class="small-button subtle" bindtap="removeCover">移除</button></view><view class="label">详情图片</view><view class="images"><view wx:for="{{form.galleryImages}}" wx:key="*this" class="image-wrap"><image src="{{item}}" mode="aspectFill" /><text data-index="{{index}}" bindtap="removeImage">×</text></view></view><button class="small-button" bindtap="gallery">＋ 添加详情图片</button></view>
  <view class="h2">每日预约时段</view><view class="muted hint">每个时段从整点开始，时长 1 小时。名额是每个时段可预约的总人数。</view><view class="card panel"><view class="slot-row" wx:for="{{form.dailySlots}}" wx:key="index"><picker range="{{hourOptions}}" data-index="{{index}}" bindchange="slotTime"><view class="picker">{{item.time}}　›</view></picker><input type="number" value="{{item.capacity}}" data-index="{{index}}" bindinput="slotCapacity" placeholder="人数" /><text>人</text><text class="remove" data-index="{{index}}" bindtap="removeSlot">删除</text></view><button class="small-button" bindtap="addSlot">＋ 添加时段</button></view>
  <view class="card publish"><view><view class="label">发布展览</view><view class="muted">开启后访客可以看到；预约还需符合日期和时段。</view></view><switch color="#705a43" checked="{{form.published}}" bindchange="published" /></view>
  <button class="btn save" loading="{{saving}}" bindtap="save">保存展览</button><button wx:if="{{id}}" class="delete" bindtap="remove">删除展览</button>
</view>
