.home { padding: 0 0 260rpx; }.demo-note { text-align: center; background: #e9e1d5; color: #6b5a48; padding: 15rpx; font-size: 22rpx; }.brand { text-align: center; padding: 32rpx 0 28rpx; }.brand-cn { font-size: 36rpx; font-weight: 500; letter-spacing: 13rpx; }.brand-en { font-size: 15rpx; letter-spacing: 8rpx; color: #927f6d; margin-top: 8rpx; }.hero { height: 560rpx; }.hero-slide { position: relative; width: 100%; height: 100%; overflow: hidden; background: #211b16; }.hero-image { display: block; width: 100%; height: 100%; }.hero-shade { position: absolute; left: 0; right: 0; bottom: 0; height: 190rpx; background: linear-gradient(transparent, rgba(0,0,0,.45)); }.hero-caption { position: absolute; left: 42rpx; bottom: 62rpx; color: #fff; font-size: 40rpx; letter-spacing: 5rpx; text-shadow: 0 2rpx 15rpx #554c43; }.hero-caption text { display: block; font-size: 18rpx; letter-spacing: 7rpx; margin-top: 12rpx; }.section-heading { display: flex; align-items: end; padding: 58rpx 32rpx 8rpx; gap: 20rpx; }.section-heading .h2 { margin: 8rpx 0 0; }.section-rule { height: 1rpx; background: #d5cec4; flex: 1; margin-bottom: 18rpx; }.exhibit-card { margin: 24rpx 32rpx; }.cover { display: block; width: 100%; height: 380rpx; }.placeholder { background: linear-gradient(135deg,#d9d3c9,#a79e90); display: flex; align-items: center; justify-content: center; color: white; font-size: 42rpx; letter-spacing: 12rpx; }.exhibit-title { font-size: 36rpx; font-weight: 600; margin: 18rpx 0 10rpx; }.detail-link { color: #745c43; margin-top: 24rpx; font-size: 26rpx; }.archive-scroll { width: 100%; }.archive-row { display: flex; gap: 20rpx; padding: 24rpx 32rpx; width: max-content; }.archive-item { width: 225rpx; }.archive-item image,.archive-placeholder { width: 225rpx; height: 225rpx; display: block; background: #d2c7b7; }.archive-placeholder { display: flex; justify-content: center; align-items: center; color: #fff; font-size: 24rpx; }.archive-title { font-weight: 600; font-size: 25rpx; margin-top: 16rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.contact { margin: 80rpx 32rpx 0; padding: 42rpx; background: #ece7df; }.contact .h2 { margin: 12rpx 0 25rpx; }.contact-line { font-size: 29rpx; margin: 14rpx 0; }

.hero-slide,.hero-image { height: 560rpx; }
.photo-note { color: #927f6d; font-size: 22rpx; margin-top: 16rpx; }
