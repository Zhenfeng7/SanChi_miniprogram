<view class="page settings-page"><view class="eyebrow">MUSEUM SETTINGS</view><view class="h1">馆方资料</view>
  <view class="card panel"><view class="label">馆名</view><input value="{{form.contactName}}" data-field="contactName" bindinput="change" placeholder="三尺美术馆" /><view class="label">联系电话</view><input value="{{form.contactPhone}}" data-field="contactPhone" bindinput="change" placeholder="对外展示的电话" /><view class="label">地址</view><input value="{{form.contactAddress}}" data-field="contactAddress" bindinput="change" placeholder="对外展示的地址" /><view class="label">开放时间</view><input value="{{form.openingHours}}" data-field="openingHours" bindinput="change" placeholder="例如：周二至周日 10:00—18:00" /></view>
  <view class="h2">预约规则</view><view class="card panel"><view class="label">至少提前几天预约</view><input type="number" value="{{form.advanceDays}}" data-field="advanceDays" bindinput="change" /><view class="muted">填 1 表示最早可约明天，填 0 表示允许约今天未开始的时段。</view><view class="label spacing">每次最多几人</view><input type="number" value="{{form.maxPeople}}" data-field="maxPeople" bindinput="change" /></view>
  <view class="h2">首页轮播照片</view><view class="muted hint">按下面的顺序播放。未添加时使用小程序内的默认照片。</view><view class="card panel"><view class="banner" wx:for="{{form.bannerImages}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" /><view class="banner-actions"><text data-index="{{index}}" data-direction="-1" bindtap="moveBanner">上移</text><text data-index="{{index}}" data-direction="1" bindtap="moveBanner">下移</text><text data-index="{{index}}" bindtap="removeBanner">移除</text></view></view><button class="small-button" bindtap="addBanner">{{uploading ? '上传中…' : '＋ 添加照片'}}</button></view>
  <button class="btn save" loading="{{saving}}" bindtap="save">保存馆方资料</button>
</view>
