.settings-page { padding-bottom:130rpx; }.panel { padding:30rpx; }.label { font-size:27rpx; font-weight:600; margin:8rpx 0 14rpx; }.panel input { width:100%; background:#f7f5f1; border-radius:5rpx; padding:18rpx; font-size:28rpx; min-height:74rpx; margin-bottom:25rpx; }.spacing { margin-top:28rpx; }.hint { margin-bottom:20rpx; }.banner { margin-bottom:25rpx; border-bottom:1rpx solid #eee8df; padding-bottom:20rpx; }.banner image { width:100%; height:260rpx; border-radius:5rpx; }.banner-actions { display:flex; gap:35rpx; color:#705a43; padding-top:12rpx; font-size:25rpx; }.small-button { background:#eee8df; color:#705a43; font-size:25rpx; height:70rpx; line-height:70rpx; margin:10rpx 0 20rpx; border-radius:5rpx; }.save { margin-top:35rpx; }
