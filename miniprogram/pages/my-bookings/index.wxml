<view class="page"><view class="eyebrow">MY RESERVATIONS</view><view class="h1">我的预约</view><view wx:if="{{!items.length}}" class="card empty">还没有预约记录</view><view class="card booking" wx:for="{{items}}" wx:key="_id"><view class="top"><view class="title">{{item.exhibitionTitle}}</view><view class="pill">{{item.status === 'active' ? '预约成功' : '已取消'}}</view></view><view class="muted">日期：{{item.date}}</view><view class="muted">时段：{{item.time}} — 1小时</view><view class="muted">人数：{{item.people}} 人</view><view class="muted">预约人：{{item.name}} · {{item.phone}}</view><view wx:if="{{item.status === 'active'}}" class="cancel" data-id="{{item._id}}" bindtap="cancel">取消预约</view></view></view>
