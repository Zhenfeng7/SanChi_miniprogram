<view wx:if="{{exhibit}}" class="detail">
  <image wx:if="{{exhibit.coverImage}}" class="hero" src="{{exhibit.coverImage}}" mode="aspectFill" /><view wx:else class="hero placeholder">SAN CHI ART</view>
  <view class="page"><view class="eyebrow">EXHIBITION</view><view class="h1">{{exhibit.title}}</view><view class="date-range">{{exhibit.startDate}} — {{exhibit.endDate}}</view><view class="description">{{exhibit.description || '展览介绍即将发布。'}}</view>
    <view wx:if="{{past}}" class="past-note">展览已结束 · 仅供浏览</view>
    <view wx:elif="{{canBook}}" class="booking-panel"><view class="h2">预约参观</view><view class="muted">每个时段 1 小时 · 提前 {{config.advanceDays}} 天开放 · 同一展览每天限约一次</view>
      <view class="subheading">选择日期</view><scroll-view scroll-x class="date-scroll"><view class="date-row"><view class="date-chip {{date === item.value ? 'selected' : ''}}" wx:for="{{dates}}" wx:key="value" data-date="{{item.value}}" bindtap="chooseDate"><view>周{{item.weekday}}</view><view class="day">{{item.day}}</view></view></view></scroll-view>
      <picker mode="date" value="{{date}}" start="{{minDate}}" end="{{exhibit.endDate}}" bindchange="pickDate"><view class="date-picker">查看其他日期：{{date}} ▾</view></picker>
      <view class="subheading">预约人数</view><view class="people-row"><view class="people {{people === item ? 'selected' : ''}}" wx:for="{{peopleOptions}}" wx:key="*this" data-people="{{item}}" bindtap="choosePeople">{{item}} 人</view></view>
      <view class="subheading">选择时段</view><view wx:if="{{!slots.length}}" class="muted">当天暂无开放时段</view><view class="slot-row"><view class="slot {{time === item.time ? 'selected' : ''}} {{item.insufficient ? 'disabled' : ''}}" wx:for="{{slots}}" wx:key="time" data-time="{{item.time}}" bindtap="chooseTime"><view>{{item.time}}</view><text>{{item.label}}</text></view></view>
      <button class="btn reserve" disabled="{{!time || busy}}" bindtap="reserve">确认预约</button>
    </view>
    <view wx:else class="past-note">当前无可预约日期</view>
  </view>
</view>
