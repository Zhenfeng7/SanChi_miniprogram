.hero { width: 100%; height: 540rpx; display: block; }.placeholder { display: flex; justify-content: center; align-items: center; background: linear-gradient(135deg,#d5c8b7,#827e73); color: #fff; letter-spacing: 10rpx; font-size: 32rpx; }.date-range { color: #80694f; font-size: 28rpx; }.description { font-size: 28rpx; line-height: 1.85; white-space: pre-wrap; margin: 40rpx 0 70rpx; }.past-note { padding: 35rpx; background: #eae5df; text-align: center; color: #7f7468; }.booking-panel { border-top: 1rpx solid #d8d1c7; }.subheading { font-size: 29rpx; font-weight: 600; margin: 42rpx 0 20rpx; }.date-scroll { white-space: nowrap; }.date-row { display: flex; width: max-content; gap: 14rpx; }.date-chip { width: 88rpx; height: 112rpx; padding: 12rpx 0; text-align: center; border: 1rpx solid #d9d0c5; color: #81796f; border-radius: 8rpx; font-size: 22rpx; }.date-chip .day { font-size: 34rpx; margin-top: 5rpx; }.selected { background: #705a43 !important; color: #fff !important; border-color: #705a43 !important; }.date-picker { padding: 24rpx 0; color: #80694f; font-size: 24rpx; }.people-row,.slot-row { display: flex; flex-wrap: wrap; gap: 16rpx; }.people { padding: 17rpx 30rpx; border: 1rpx solid #d5cdc3; border-radius: 6rpx; font-size: 25rpx; }.slot { width: 31%; min-width: 180rpx; border: 1rpx solid #d5cdc3; border-radius: 6rpx; padding: 20rpx 12rpx; text-align: center; font-size: 27rpx; background: #fff; }.slot text { display: block; font-size: 20rpx; margin-top: 8rpx; }.disabled { opacity: .42; }.reserve { margin-top: 58rpx; }
