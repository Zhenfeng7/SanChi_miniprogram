<template name="bookingCard"><view class="card booking"><view class="booking-head"><view><view class="title">{{booking.exhibitionTitle}}</view><view class="muted">{{booking.date}}　{{booking.time}}（1小时）</view></view><view class="pill">{{booking.status === 'active' ? '有效' : '已取消'}}</view></view><view class="info">{{booking.name}}　{{booking.phone}}　{{booking.people}}人</view><view class="muted">{{booking.source === 'admin' ? '馆方代约' : '访客预约'}}</view><view wx:if="{{booking.status === 'active'}}" class="booking-actions"><text data-id="{{booking._id}}" bindtap="edit">修改</text><text data-id="{{booking._id}}" bindtap="cancel">取消预约</text></view></view></template>
<view class="page bookings-page"><view class="eyebrow">RESERVATIONS</view><view class="h1">预约管理</view>
  <view wx:if="{{mode === 'list'}}">
    <view class="top-actions"><button class="small-button" bindtap="newBooking">＋ 代客预约</button><text bindtap="toggleAll">{{showAll ? '收起全部' : '显示全部'}}</text></view>
    <view class="section-heading"><view><view class="eyebrow">TODAY</view><view class="h2">今天的预约 <text class="count">{{todayBookings.length}}</text></view></view><text class="muted">{{today}}</text></view>
    <view wx:if="{{!todayBookings.length}}" class="card empty section-empty">{{showAll ? '今天没有预约记录' : '今天没有有效预约'}}</view>
    <block wx:for="{{todayBookings}}" wx:key="_id"><template is="bookingCard" data="{{booking: item}}" /></block>
    <view class="section-heading future-heading" bindtap="toggleFuture"><view><view class="eyebrow">UPCOMING</view><view class="h2">之后的预约 <text class="count">{{futureBookings.length}}</text></view></view><text class="expand-label">{{futureExpanded ? '收起' : '展开'}}　{{futureExpanded ? '⌃' : '⌄'}}</text></view>
    <view wx:if="{{futureExpanded}}"><view wx:if="{{!futureBookings.length}}" class="card empty section-empty">之后没有预约记录</view><block wx:for="{{futureBookings}}" wx:key="_id"><template is="bookingCard" data="{{booking: item}}" /></block></view>
    <view wx:if="{{showAll}}"><view class="section-heading"><view><view class="eyebrow">PAST 7 DAYS</view><view class="h2">过去一周 <text class="count">{{pastWeekBookings.length}}</text></view></view></view><view wx:if="{{!pastWeekBookings.length}}" class="card empty section-empty">过去一周没有预约记录</view><block wx:for="{{pastWeekBookings}}" wx:key="_id"><template is="bookingCard" data="{{booking: item}}" /></block></view>
  </view>
  <view wx:else><view class="muted">{{mode === 'new' ? '填写客人资料并选择预约时段' : '修改预约日期、时段、人数或姓名'}}</view><view class="card panel"><view class="label">展览 *</view><picker wx:if="{{mode === 'new'}}" range="{{exhibitions}}" range-key="title" bindchange="chooseExhibition"><view class="picker">{{exhibitionName || '请选择展览'}}　›</view></picker><view wx:else class="picker">{{exhibitionName}}</view><view class="label">日期 *</view><picker mode="date" value="{{form.date}}" bindchange="chooseDate"><view class="picker">{{form.date || '请选择日期'}}　›</view></picker><view class="label">时间 *</view><picker range="{{timeOptions}}" bindchange="chooseTime"><view class="picker">{{form.time || '请选择时段'}}　›</view></picker><view class="label">人数 *</view><input type="number" value="{{form.people}}" data-field="people" bindinput="text" /><view class="label">客人姓名 *</view><input value="{{form.name}}" data-field="name" bindinput="text" placeholder="填写客人姓名" maxlength="40" /><view class="label">手机号 *</view><input type="text" value="{{form.phone}}" data-field="phone" bindinput="text" placeholder="填写客人手机号" maxlength="30" disabled="{{phoneLocked}}" /></view><button class="btn save" loading="{{saving}}" bindtap="save">{{mode === 'new' ? '确认代约' : '保存修改'}}</button><button class="back" bindtap="back">返回预约列表</button></view>
</view>
