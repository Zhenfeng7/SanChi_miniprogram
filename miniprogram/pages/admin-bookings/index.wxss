.bookings-page { padding-bottom:130rpx; }.top-actions { display:flex; align-items:center; justify-content:space-between; margin-bottom:24rpx; color:#705a43; font-size:25rpx; }.small-button { background:#705a43; color:#fff; font-size:25rpx; height:70rpx; line-height:70rpx; margin:0; padding:0 25rpx; border-radius:5rpx; }.booking { padding:28rpx; }.booking-head { display:flex; justify-content:space-between; gap:15rpx; }.title { font-size:30rpx; font-weight:600; margin-bottom:8rpx; }.info { font-size:28rpx; margin:22rpx 0 6rpx; }.booking-actions { display:flex; gap:35rpx; border-top:1rpx solid #eee8df; padding-top:20rpx; margin-top:20rpx; color:#705a43; font-size:26rpx; }.booking-actions text:last-child { color:#9a4e42; }.panel { padding:30rpx; margin-top:25rpx; }.label { font-size:27rpx; font-weight:600; margin:8rpx 0 14rpx; }.panel input,.picker { width:100%; background:#f7f5f1; border-radius:5rpx; padding:18rpx; font-size:28rpx; min-height:74rpx; margin-bottom:25rpx; }.save { margin-top:30rpx; }.back { margin-top:15rpx; background:transparent; color:#705a43; font-size:26rpx; }
