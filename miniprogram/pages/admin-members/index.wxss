.members-page{padding-bottom:130rpx}.intro{line-height:1.7;margin:0 0 32rpx}.member{display:flex;align-items:center;justify-content:space-between;padding:25rpx 30rpx;margin-bottom:16rpx}.person{min-width:0}.name{font-size:30rpx;font-weight:600}.owner{font-size:21rpx;color:#705a43;background:#eee8df;padding:6rpx 12rpx;margin-left:12rpx;border-radius:5rpx}.remove{margin:0 0 0 20rpx;background:#f4efea;color:#705a43;font-size:23rpx;height:60rpx;line-height:60rpx;padding:0 20rpx}.panel{padding:30rpx}.label{font-size:26rpx;font-weight:600;margin-bottom:15rpx}.panel input{background:#f7f5f1;padding:20rpx;font-size:28rpx;min-height:75rpx;margin-bottom:25rpx}.secondary{background:#eee8df;color:#705a43;font-size:26rpx;margin:0;height:76rpx;line-height:76rpx}.candidate{border-top:1rpx solid #e8e0d6;margin-top:28rpx;padding-top:25rpx}.candidate .btn{margin-top:22rpx}
