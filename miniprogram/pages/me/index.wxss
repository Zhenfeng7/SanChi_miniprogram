.identity { display: flex; align-items: center; padding: 34rpx; margin-top: 55rpx; gap: 24rpx; }.avatar { width: 100rpx; height: 100rpx; background: #c7b49e; border-radius: 50%; color: #fff; text-align: center; line-height: 100rpx; font-size: 42rpx; }.name { font-size: 31rpx; font-weight: 600; }.arrow { margin-left: auto; color: #9f958b; font-size: 42rpx; }.menu { padding: 30rpx; display: flex; justify-content: space-between; font-size: 29rpx; }.menu text:last-child { color: #a69a8d; }
