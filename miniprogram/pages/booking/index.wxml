<view class="page"><view class="eyebrow">RESERVATIONS</view><view class="h1">预约参观</view><view class="muted">选择展览，查看开放日期与剩余名额</view><view class="h2">可预约展览</view><view wx:if="{{!items.length}}" class="card empty">当前暂无开放预约的展览</view><view class="card item" wx:for="{{items}}" wx:key="_id" data-id="{{item._id}}" bindtap="detail"><image wx:if="{{item.coverImage}}" src="{{item.coverImage}}" mode="aspectFill" /><view wx:else class="thumb">ART</view><view class="info"><view class="pill">{{item.phase === 'upcoming' ? '即将开幕' : '正在展出'}}</view><view class="title">{{item.title}}</view><view class="muted">{{item.startDate}} — {{item.endDate}}</view><view class="go">选择日期 →</view></view></view></view>
