.tab-bar { display: flex; height: 136rpx; background: #fff; border-top: 1rpx solid #dedbd6; padding-bottom: env(safe-area-inset-bottom); }
.tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.icon { width: 82rpx; height: 82rpx; }
.label { margin-top: 5rpx; color: #77736d; font-size: 25rpx; line-height: 1.2; }
.label.active { color: #735d45; }
